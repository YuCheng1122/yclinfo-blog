---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('zh');

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ id, data }) => id.startsWith('zh/') && !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.slice('zh/'.length) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const slug = post.id.slice('zh/'.length);
const enCounterpart = await getEntry('blog', `en/${slug}`);
const langSwitchHref = enCounterpart ? `/en/blog/${slug}/` : null;

const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  url: `https://yclinfo.com/blog/${slug}/`,
  author: { '@type': 'Person', name: 'Tommy Lin' },
};
---

<Layout title={post.data.title} description={post.data.description} langSwitchHref={langSwitchHref} pubDate={post.data.pubDate}>
  <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
  <article>
    <h1>{post.data.title}</h1>
    <p class="dim">{post.data.pubDate.toLocaleDateString('zh-TW')}</p>
    <Content />
  </article>
  <p><a href="/blog/">{t('blog.back')}</a></p>
</Layout>
